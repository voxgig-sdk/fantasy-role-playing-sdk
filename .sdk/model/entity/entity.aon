# Entity: entity

main: kit: entity: entity: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Description of the advantage"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the advantage"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the advantage"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "entity"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/advantages"
          segments: [
            {
              lit: "advantages"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/disadvantages"
          segments: [
            {
              lit: "disadvantages"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/skills"
          segments: [
            {
              lit: "skills"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
