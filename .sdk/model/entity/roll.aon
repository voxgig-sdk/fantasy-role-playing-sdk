# Entity: roll

main: kit: entity: roll: {

  alias: field: {}

  fields: [
    {
      name: "advantages"
      req: false
      short: "Character advantages"
      type: "`$ARRAY`"
    }
    {
      name: "attributes"
      req: false
      short: "Character attributes and stats"
      type: "`$OBJECT`"
    }
    {
      name: "class"
      req: false
      short: "Class of the character"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Description of the set"
      type: "`$STRING`"
    }
    {
      name: "disadvantages"
      req: false
      short: "Character disadvantages"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the character"
      type: "`$STRING`"
    }
    {
      name: "items"
      req: false
      short: "Items included in the set"
      type: "`$ARRAY`"
    }
    {
      name: "level"
      req: false
      short: "Level of the character"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the character"
      type: "`$STRING`"
    }
    {
      name: "race"
      req: false
      short: "Race of the character"
      type: "`$STRING`"
    }
    {
      name: "skills"
      req: false
      short: "Character skills"
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "roll"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/roll/character"
          parts: [
            "roll"
            "character"
          ]
          select: {
            "$action": "character"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/roll/set"
          parts: [
            "roll"
            "set"
          ]
          select: {
            "$action": "set"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/roll/item"
          parts: [
            "roll"
            "item"
          ]
          select: {
            "$action": "item"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.properties`"
          }
        }
      ]
    }
  }



}
